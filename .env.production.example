EXHIBITOR_DOMAIN=scan.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com
# Space-separated CIDRs accepted by Caddy. Use your VPN/IAP egress ranges.
ADMIN_ALLOWED_CIDRS=203.0.113.10/32

EXHIBITOR_DATABASE_URL=postgres://exhibitor_app:replace-me@database.example.com:5432/exhibition?sslmode=verify-full
ADMIN_DATABASE_URL=postgres://admin_app:replace-me@database.example.com:5432/exhibition?sslmode=verify-full
MIGRATION_DATABASE_URL=postgres://migrator:replace-me@database.example.com:5432/exhibition?sslmode=verify-full

ADMIN_SESSION_SECRET=generate-an-independent-random-secret-of-at-least-32-characters
EXHIBITOR_SESSION_SECRET=generate-an-independent-random-secret-of-at-least-32-characters
ADMIN_DATABASE_POOL_SIZE=10
EXHIBITOR_DATABASE_POOL_SIZE=10
ALLOW_INSECURE_DATABASE=0
