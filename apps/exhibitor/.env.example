# Postgres connection string (packages/db reads this).
DATABASE_URL=postgres://exhibition:exhibition@localhost:5432/exhibition

# HS256 signing secret for exhibitor session JWTs. Generate with:
#   openssl rand -base64 32
# Never commit a real value.
SESSION_SECRET=dev-secret-change-me

# Directory where admin-uploaded assets (logos) are stored. In dev this
# defaults to .uploads/ (symlinked to apps/admin/.uploads); in Docker
# both containers mount the same uploads-data volume to /app/uploads.
# UPLOADS_DIR=/app/uploads
