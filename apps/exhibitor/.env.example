DATABASE_URL=postgres://exhibitor_app:replace-me@database.example.com:5432/exhibition?sslmode=verify-full
EXHIBITOR_SESSION_SECRET=generate-at-least-32-random-characters
EXHIBITOR_PUBLIC_ORIGIN=https://exhibitor.example.com
TRUST_PROXY=1
DATABASE_POOL_SIZE=10
# Set to 1 only when Postgres is on a private, single-host network and TLS is handled outside the connection.
ALLOW_INSECURE_DATABASE=0
