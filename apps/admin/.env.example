DATABASE_URL=postgres://admin_app:replace-me@database.example.com:5432/exhibition?sslmode=verify-full
ADMIN_SESSION_SECRET=generate-at-least-32-random-characters
ADMIN_PUBLIC_ORIGIN=https://admin.example.com
TRUST_PROXY=1
DATABASE_POOL_SIZE=10
UPLOADS_DIR=/app/uploads
# Set to 1 only when Postgres is on a private, single-host network and TLS is handled outside the connection.
ALLOW_INSECURE_DATABASE=0
