# Postgres connection string (packages/db reads this).
DATABASE_URL=postgres://exhibition:exhibition@localhost:5432/exhibition

# HS256 signing secret for admin session JWTs -- MUST be a different value
# per app in a real deployment is not required (same secret can be shared),
# but the cookie name/table/verification are still fully separate realms
# from the exhibitor app. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-secret-change-me

# Absolute, publicly-reachable origin of THIS admin app (no trailing
# slash). Uploaded logos are served back out by this app's own
# /uploads/[...path] route -- but event_settings.logo_url is read by the
# EXHIBITOR app too, which may live on a completely different subdomain,
# so the stored URL must be absolute, not relative.
ADMIN_PUBLIC_URL=http://localhost:3001

# Local-disk directory where uploaded logos are stored (see lib/uploads.ts
# and the /uploads/[...path] route that serves them back out). Defaults to
# ./.uploads next to the running process if unset -- in Docker this is set
# to /app/uploads, a mounted volume, so uploads survive container restarts.
UPLOADS_DIR=.uploads

# Bootstrap admin, used only by `pnpm --filter @repo/db seed` (see
# packages/db/src/seed.ts) -- not read by the app itself.
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
